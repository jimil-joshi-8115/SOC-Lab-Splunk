<dashboard version="1.1">
  <label>SOC Security Dashboard</label>
  <description>SOC L1 Home Lab — Security Monitoring</description>
  <row>
    <panel>
      <single>
        <title>Failed Login Attempts</title>
        <search>
          <query>index=main sourcetype="WinEventLog:Security" EventCode=4625 | stats count</query>
          <earliest>-30d</earliest>
          <latest>now</latest>
        </search>
      </single>
    </panel>
    <panel>
      <single>
        <title>New User Accounts Created</title>
        <search>
          <query>index=main sourcetype="WinEventLog:Security" EventCode=4720 | stats count</query>
          <earliest>-30d</earliest>
          <latest>now</latest>
        </search>
      </single>
    </panel>
    <panel>
      <single>
        <title>Log Clearing Events</title>
        <search>
          <query>index=main sourcetype="WinEventLog:Security" EventCode=1102 | stats count</query>
          <earliest>-30d</earliest>
          <latest>now</latest>
        </search>
      </single>
    </panel>
    <panel>
      <single>
        <title>Privilege Escalation Events</title>
        <search>
          <query>index=main sourcetype="WinEventLog:Security" EventCode=4732 | stats count</query>
          <earliest>-30d</earliest>
          <latest>now</latest>
        </search>
      </single>
    </panel>
  </row>
  <row>
    <panel>
      <single>
        <title>Malicious Services Installed</title>
        <search>
          <query>index=main sourcetype="WinEventLog:System" EventCode=7045 | stats count</query>
          <earliest>-30d</earliest>
          <latest>now</latest>
        </search>
      </single>
    </panel>
    <panel>
      <single>
        <title>Account Lockouts</title>
        <search>
          <query>index=main sourcetype="WinEventLog:Security" EventCode=4740 | stats count</query>
          <earliest>-30d</earliest>
          <latest>now</latest>
        </search>
      </single>
    </panel>
    <panel>
      <single>
        <title>PowerShell Events</title>
        <search>
          <query>index=main EventCode=4104 | stats count</query>
          <earliest>-30d</earliest>
          <latest>now</latest>
        </search>
      </single>
    </panel>
    <panel>
      <single>
        <title>Process Creation Events</title>
        <search>
          <query>index=main sourcetype="WinEventLog:Security" EventCode=4688 | stats count</query>
          <earliest>-30d</earliest>
          <latest>now</latest>
        </search>
      </single>
    </panel>
  </row>
  <row>
    <panel>
      <chart>
        <title>Failed Logins Over Time</title>
        <search>
          <query>index=main sourcetype="WinEventLog:Security" EventCode=4625 | timechart count by Account_Name</query>
          <earliest>-30d</earliest>
          <latest>now</latest>
        </search>
        <option name="charting.chart">line</option>
      </chart>
    </panel>
    <panel>
      <chart>
        <title>Top Suspicious Processes</title>
        <search>
          <query>index=main sourcetype="WinEventLog:Security" EventCode=4688 | search New_Process_Name="*cmd.exe*" OR New_Process_Name="*powershell.exe*" OR New_Process_Name="*net.exe*" | stats count by New_Process_Name | sort -count | head 10</query>
          <earliest>-30d</earliest>
          <latest>now</latest>
        </search>
        <option name="charting.chart">bar</option>
      </chart>
    </panel>
  </row>
  <row>
    <panel>
      <table>
        <title>Recent Security Events</title>
        <search>
          <query>index=main sourcetype="WinEventLog:Security" EventCode=4625 OR EventCode=4720 OR EventCode=4732 OR EventCode=4740 OR EventCode=1102 | table _time, EventCode, Account_Name, ComputerName | sort -_time | head 20</query>
          <earliest>-30d</earliest>
          <latest>now</latest>
        </search>
      </table>
    </panel>
  </row>
</dashboard>
