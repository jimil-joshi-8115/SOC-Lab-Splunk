# Scenario 09 — Credential Dumping: LSASS Memory (T1003.001)

# Query 1: Detect simulated procdump-style LSASS targeting command
index=main sourcetype="WinEventLog:Security" EventCode=4688
Process_Command_Line="*procdump*" Process_Command_Line="*lsass*"
| table _time, Account_Name, New_Process_Name, Process_Command_Line
| sort -_time

# Query 2: Detect reconnaissance of lsass.exe process via tasklist
index=main sourcetype="WinEventLog:Security" EventCode=4688
New_Process_Name="*tasklist.exe"
Process_Command_Line="*lsass*"
| table _time, Account_Name, New_Process_Name, Process_Command_Line
| sort -_time

# Query 3: Detect credential-harvesting style findstr search
index=main sourcetype="WinEventLog:Security" EventCode=4688
New_Process_Name="*findstr.exe"
Process_Command_Line="*password*"
| table _time, Account_Name, New_Process_Name, Process_Command_Line
| sort -_time

# Query 4: Combined view — full credential dumping attempt chain
index=main sourcetype="WinEventLog:Security" EventCode=4688
(Process_Command_Line="*lsass*") OR (New_Process_Name="*findstr.exe" Process_Command_Line="*password*")
| table _time, Account_Name, New_Process_Name, Process_Command_Line
| sort -_time
