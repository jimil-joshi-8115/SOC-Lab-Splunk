# Scenario 10 — Password Spray (T1110.003)

# Query 1: Detect multiple distinct accounts with failed logons within a short time window
index=main sourcetype="WinEventLog:Security" EventCode=4625
| bucket _time span=2m
| stats dc(Account_Name) as distinct_accounts, values(Account_Name) as accounts_targeted, count as failed_attempts by _time
| where distinct_accounts >= 3
| sort -_time

# Query 2: Raw failed logon events for the simulated spray targets
index=main sourcetype="WinEventLog:Security" EventCode=4625
Account_Name="hp1" OR Account_Name="hp2" OR Account_Name="administrator" OR Account_Name="guest"
| table _time, Account_Name, Caller_Computer_Name, Failure_Reason
| sort -_time

# Query 3: Combined view — full password spray pattern (all targeted accounts, single window)
index=main sourcetype="WinEventLog:Security" EventCode=4625
| stats count as failed_attempts, values(Account_Name) as targeted_accounts, dc(Account_Name) as unique_accounts
| where unique_accounts >= 3

# Comparison note: contrast with Lab 01 (Brute Force) detection logic —
# brute force = many failed attempts against ONE account; password spray =
# few failed attempts spread across MANY accounts. Same Event ID (4625),
# different stats grouping reveals the different attacker technique.
