# Insider Threat Detection - SPL Query
# Author: Jimil Joshi
# Date: 15-06-2026
# Scenario: Insider Threat — Backdoor Account + Privilege Escalation + Evidence Destruction
# MITRE ATT&CK: T1136, T1098, T1070.001

# -----------------------------------------------
# Query 1: Full Insider Threat Attack Chain
# Correlates new user, admin escalation and log clearing
# -----------------------------------------------
index=main sourcetype="WinEventLog:Security"
(EventCode=4720 OR EventCode=4732 OR EventCode=4625 OR EventCode=1102)
| eval Attack=case(
    EventCode="4720","1-New User Created",
    EventCode="4732","2-Added to Admins",
    EventCode="4625","3-Failed Logins",
    EventCode="1102","4-Log Clearing")
| stats count by Attack, Account_Name, ComputerName
| sort Attack

# -----------------------------------------------
# Query 2: New User Created
# -----------------------------------------------
index=main sourcetype="WinEventLog:Security" EventCode=4720
| table _time, Account_Name, ComputerName, Security_ID
| sort -_time

# -----------------------------------------------
# Query 3: Privilege Escalation
# -----------------------------------------------
index=main sourcetype="WinEventLog:Security" EventCode=4732
| table _time, Account_Name, ComputerName, Security_ID
| sort -_time

# -----------------------------------------------
# Query 4: Log Clearing — Evidence Destruction
# -----------------------------------------------
index=main sourcetype="WinEventLog:Security" EventCode=1102
| table _time, Account_Name, ComputerName, Message
| sort -_time

# -----------------------------------------------
# Query 5: Complete Attack Timeline
# -----------------------------------------------
index=main sourcetype="WinEventLog:Security"
(EventCode=4720 OR EventCode=4732 OR EventCode=1102)
| eval Stage=case(
    EventCode="4720","Persistence — Backdoor Account",
    EventCode="4732","Privilege Escalation",
    EventCode="1102","Defense Evasion — Log Clearing")
| table _time, Stage, Account_Name, ComputerName
| sort _time
