# Scenario 06 — LOLBins & Execution Abuse (T1218.005, T1218.011, T1105)

# Query 1: Detect mshta.exe execution (script/HTA abuse)
index=main sourcetype="WinEventLog:Security" EventCode=4688
New_Process_Name="*mshta.exe"
| table _time, Account_Name, New_Process_Name, Process_Command_Line
| sort -_time

# Query 2: Detect rundll32.exe abuse
index=main sourcetype="WinEventLog:Security" EventCode=4688
New_Process_Name="*rundll32.exe"
| table _time, Account_Name, New_Process_Name, Process_Command_Line
| sort -_time

# Query 3: Detect regsvr32.exe abuse (Squiblydoo technique)
index=main sourcetype="WinEventLog:Security" EventCode=4688
New_Process_Name="*regsvr32.exe"
| table _time, Account_Name, New_Process_Name, Process_Command_Line
| sort -_time

# Query 4: Combined LOLBin detection — all three in one view
index=main sourcetype="WinEventLog:Security" EventCode=4688
New_Process_Name="*mshta.exe" OR New_Process_Name="*rundll32.exe" OR New_Process_Name="*regsvr32.exe"
| table _time, Account_Name, New_Process_Name, Process_Command_Line
| sort -_time

# Query 5 (Tuning note): rundll32.exe fires constantly from legitimate OS
# background tasks (e.g. PcaSvc.dll PcaPatchSdbTask, AppXDeploymentExtensions.
# OneCore.dll ShellRefresh triggered by the JIMIL-JOSHI$ machine account).
# Production detection should filter on suspicious arguments/exports rather
# than the binary name alone, to avoid high false-positive volume.
index=main sourcetype="WinEventLog:Security" EventCode=4688
New_Process_Name="*rundll32.exe"
NOT (Process_Command_Line="*PcaSvc.dll*" OR Process_Command_Line="*AppXDeploymentExtensions*")
| table _time, Account_Name, New_Process_Name, Process_Command_Line
| sort -_time
